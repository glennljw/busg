# Server-only secret -- used by the bus-stops server component and the bus-arrival
# route handler. Never expose this with a NEXT_PUBLIC_ prefix.
# Get a key at https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_API_KEY=

# Public client-side token for Mapbox GL JS. Scope this token to your domain in the
# Mapbox dashboard -- it is safe to expose in the browser bundle.
NEXT_PUBLIC_MAPBOX_KEY=
